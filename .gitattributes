# Файлы, которые исполняются на Linux-сервере, всегда с LF —
# даже если репозиторий склонирован на Windows с core.autocrlf=true
*.sh                    text eol=lf
Dockerfile              text eol=lf
*.yml                   text eol=lf
deploy/*.conf           text eol=lf
requirements*.txt       text eol=lf

# cmd.exe требует CRLF: с LF метки и блоки в скобках в .bat ломаются
*.bat                   text eol=crlf
