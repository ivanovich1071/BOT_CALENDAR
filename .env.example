# ============================================================
# 09-09 BOT_CALENDAR — шаблон конфигурации.
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# Все значения ниже — ЗАГЛУШКИ, секреты не хранятся в git.
# ============================================================

# ==== Базовые ====
APP_ENV=development                # development | staging | production
APP_BASE_URL=http://localhost:8000 # публичный адрес админки/API
SECRET_KEY=                        # сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=                    # для шифрования Google-токенов: python -c "import secrets;print(secrets.token_urlsafe(32))"

# ==== База данных / Redis ====
POSTGRES_PASSWORD=                 # придумайте надежный пароль
# Локальная разработка (контейнер публикуется на 5433, чтобы не конфликтовать
# с локальным PostgreSQL): localhost:5433. В Docker-сети: postgres:5432
DATABASE_URL=postgresql+psycopg://booking:ПАРОЛЬ@localhost:5433/booking
REDIS_URL=redis://redis:6379/0

# ==== Telegram ====
# Токен бота от @BotFather (docs/TELEGRAM_SETUP.md)
BOT_TOKEN=
BOT_WEBHOOK_SECRET=                # произвольная строка для проверки вебхуков

# ==== OpenRouter (AI) ====
# Ключ заказчика с https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-max
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=2000

# ==== Google Cloud (OAuth 2.0) ====
# docs/GOOGLE_SETUP.md — свой проект заказчика
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ВАШ-ДОМЕН/oauth/google/callback

# ==== Локализация ====
TIMEZONE=Europe/Moscow
